# Copy to .env and set your values. App uses Microsoft SQL Server by default.

NODE_ENV=production
PORT=3010
HOST=192.168.216.27
# Admin login (JWT). Required in production: set a strong JWT_SECRET.
JWT_SECRET=change-me-in-production
# Optional: seed one admin on first run if Admins table is empty
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# Microsoft SQL Server
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_NAME=AssetManagement
DB_ENCRYPT=false

# SMTP for manually emailing selected inventory rows to management
INVENTORY_REPORT_TO=management@yourcompany.com
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=inventory-reports@yourcompany.com
SMTP_PASS=your-smtp-password
# MAIL_FROM=Data Center Inventory <inventory-reports@yourcompany.com>

CORS_ORIGIN=https://yourdomain.com



