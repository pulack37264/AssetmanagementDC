# Production environment — copy to .env and set real values.
# Never commit .env with real secrets.

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Required: use a long random secret (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-in-production

# Optional: restrict CORS to your frontend origin when using a separate domain
# CORS_ORIGIN=https://yourdomain.com

# Optional: seed admin on first run if Admins table is empty
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# Microsoft SQL Server (must be reachable from this server)
DB_SERVER=your-sql-server-hostname-or-ip
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=AssetManagement
DB_ENCRYPT=true

# SMTP for manually emailed asset/license selections
INVENTORY_REPORT_TO=management@yourcompany.com
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=inventory-reports@yourcompany.com
SMTP_PASS=your-smtp-password
# MAIL_FROM=Data Center Inventory <inventory-reports@yourcompany.com>
# Set SMTP_SECURE=true when using port 465.

